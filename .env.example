# ==========================================
# MOONY DISCORD SUPERBOT CONFIGURATION
# ==========================================

# Discord Bot Credentials (Required)
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=

# Bot Owner ID for administrator overrides (Optional)
OWNER_ID=

# AI Integration (Optional - for natural language / chat)
# Gemini API Key (https://aistudio.google.com/) or OpenAI API Key
GEMINI_API_KEY=
OPENAI_API_KEY=

# Spotify API Credentials (Optional - enhanced metadata fetching)
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Built-in Web Dashboard Port
PORT=3000

# Default Bot Prefix (Optional fallback for text triggers)
DEFAULT_PREFIX=!
