# ==========================================
# 🌙 Moony Discord Bot Environment Settings
# ==========================================

# Discord Bot Credentials (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_test_guild_id_here
OWNER_ID=your_discord_user_id_here

# Bot Configuration
DEFAULT_PREFIX=!
PORT=3000

# 24/7 Keep-Alive & Self-Pinger (Optional backup for UptimeRobot)
# Set this to your public deployment URL (e.g. https://moony.onrender.com)
KEEP_ALIVE_URL=
SELF_PING_INTERVAL=4

# AI Features (Optional)
GEMINI_API_KEY=
OPENAI_API_KEY=